# RailRadar API Credentials (Connects backend to the official RailRadar API server)
RAILRADAR_API_KEY=your_railradar_api_key_here
RAILRADAR_BASE_URL=https://api.railradar.in/v1

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated or left empty to use defaults)
ALLOWED_ORIGINS=https://rail-helper.vercel.app,http://localhost:5173
